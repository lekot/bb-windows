+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct UsageSample {
+    pub used_tokens: u64,
+    pub window_tokens: u64,
+}
+
+/// Extract the current context-occupancy sample from a `session/read`
+/// result. The projection carries the same numbers the native UI renders
+/// (last main-turn model call: input including cache, plus its output).
+pub fn usage_from_snapshot(value: &serde_json::Value) -> Option<UsageSample> {
+    let snapshot: SessionReadSnapshot = serde_json::from_value(value.clone()).ok()?;
+    let projection = snapshot.projection?;
+    let window_tokens = projection.context_window.filter(|w| *w > 0)?;
+    let used_tokens = projection.context_used?;
+    Some(UsageSample {
+        used_tokens,
+        window_tokens,
+    })
+}
