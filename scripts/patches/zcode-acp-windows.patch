+#[cfg(windows)]
+fn process_created(child: &tokio::process::Child) -> Option<String> {
+    #[repr(C)]
+    #[derive(Default)]
+    struct FileTime { low: u32, high: u32 }
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn GetProcessTimes(handle: *mut std::ffi::c_void, creation: *mut FileTime, exit: *mut FileTime, kernel: *mut FileTime, user: *mut FileTime) -> i32;
+    }
+    let handle = child.raw_handle()?;
+    let (mut creation, mut exit, mut kernel, mut user) = (FileTime::default(), FileTime::default(), FileTime::default(), FileTime::default());
+    if unsafe { GetProcessTimes(handle, &mut creation, &mut exit, &mut kernel, &mut user) } == 0 { return None; }
+    Some((((creation.high as u64) << 32) | creation.low as u64).to_string())
+}
