+
+impl UsageReader {
+    /// Request the authoritative per-call context sample with a bounded
+    /// timeout and `messageLimit: 1` (no unbounded dialog read). Unknown or
+    /// malformed snapshot shapes yield `None` — never a synthesized value.
+    pub async fn read(&self) -> Option<protocol::UsageSample> {
+        let (rx, epoch) = {
+            let mut s = self.state.lock().await;
+            let params = json!({"sessionId": s.zcode_session_id, "messageLimit": 1});
+            (s.request(protocol::methods::SESSION_READ, params).ok()?, s.usage_epoch)
+        };
+        let result = tokio::time::timeout(
+            std::time::Duration::from_millis(2_000),
+            rx,
+        )
+        .await;
+        let mut state = self.state.lock().await;
+        state.pending.retain(|_, sender| !sender.is_closed());
+        if state.usage_epoch != epoch { return None; }
+        let value = result.ok()?.ok()?.ok()?;
+        protocol::usage_from_snapshot(&value)
+    }
+}
