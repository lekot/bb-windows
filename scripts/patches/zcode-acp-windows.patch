+            if let Some(value) = native_metadata {
+                payload["result"]["metadata"] = value;
+            } else {
+                payload["result"]["display"]["filePath"] = serde_json::json!("C:\\different.txt");
+            }
+            let original = payload.clone();
+            let mut event = EventEnvelope { event_id:"e".into(),session_id:"s".into(),seq:1,
+                turn_id:None,timestamp:0,type_:"tool.updated".into(),payload:Some(payload) };
+            enrich_completed_edit(&mut event, &mut cache);
+            assert_eq!(event.payload.unwrap(), original);
+        }
+    }
+}
