 /// Translate a ZCode event into one or more ACP `session/update` notifications.
+fn restore_streamed_tool_input(event: &str, payload: &mut serde_json::Value, inputs: &mut HashMap<String, serde_json::Value>) {
+    let Some(id) = payload.get("toolCallId").and_then(serde_json::Value::as_str).map(str::to_owned) else { return; };
+    if event == "model.streaming" && payload["kind"] == "tool_call" {
+        if let Some(input) = payload.get("input") {
+            if inputs.len() >= 256 { inputs.clear(); }
+            inputs.insert(id, input.clone());
+        }
+    } else if event == "tool.updated" && payload["kind"] == "scheduled" {
+        if let Some(input) = inputs.remove(&id) {
+            if payload.get("input").is_none() { payload["input"] = input; }
+        }
+    }
+}
