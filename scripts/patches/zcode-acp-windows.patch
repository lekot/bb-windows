+fn configured_model_capabilities(id: &str, configured: &Value) -> Value {
+    let mut model = json!({"modelId":id,"supportsImages":id.eq_ignore_ascii_case("glm-5.3-flash")});
+    if let Some(window) = configured.get("contextWindow").and_then(Value::as_u64).filter(|window| *window > 0 && *window <= 9_007_199_254_740_991) {
+        model["contextWindow"] = json!(window);
+    }
+    model
+}
