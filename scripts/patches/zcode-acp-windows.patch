+        assert_eq!(request["method"], "session/read");
+        assert_eq!(request["params"]["sessionId"], "test-session");
+        assert_eq!(request["params"]["messageLimit"], 1);
+        if timeout {
+            assert!(read_task.await.unwrap().is_none());
+            assert!(state.lock().await.pending.is_empty());
+            return;
+        }
+        if stale { state.lock().await.usage_epoch += 1; }
+        let id: RequestId = serde_json::from_value(request["id"].clone()).unwrap();
+        state
+            .lock()
+            .await
