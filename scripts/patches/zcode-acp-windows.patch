+pub fn enrich_completed_edit(event: &mut EventEnvelope, results: &mut std::collections::HashMap<String, Value>) {
+    let Some(payload) = event.payload.as_mut() else { return; };
+    if event.type_ == "part.upserted" {
+        let Some(part) = payload.get("part") else { return; };
+        if part.get("sessionId").and_then(Value::as_str) != Some(event.session_id.as_str())
+            || part["type"] != "tool" || part["state"]["status"] != "completed" {
+            return;
+        }
+        let Some(id) = part.get("callId").and_then(Value::as_str).filter(|id| !id.is_empty()) else { return; };
+        let state = &part["state"];
+        let result = serde_json::json!({"metadata": state["metadata"], "content": state["output"]});
+        if tool_diff_content(None, Some(&result)).is_none() { return; }
+        let id = id.to_owned();
+        let translated = serde_json::json!({"kind":"result", "toolCallId":id, "toolName":part["tool"], "result":result});
+        if results.len() >= 256 { results.clear(); }
+        results.insert(id, result);
+        *payload = translated;
+        event.type_ = "tool.updated".to_owned();
+    } else if event.type_ == "tool.updated" && payload["kind"] == "result" {
+        if let Some(result) = payload.get("toolCallId").and_then(Value::as_str).and_then(|id| results.get(id)) {
+            if payload["result"].get("metadata").is_none()
+                && payload["result"]["display"] == result["metadata"]["display"] {
+                payload["result"]["metadata"] = result["metadata"].clone();
+            }
+        }
+    }
+}
+
+pub async fn load_completed_edit(event: &mut EventEnvelope, node: &str, cwd: &std::path::Path) {
+    let Some(payload) = event.payload.as_mut() else { return; };
+    if event.type_ != "tool.updated" || payload["kind"] != "result"
+        || payload["result"]["display"]["kind"] != "file_diff" { return; }
+    let Some(call) = payload.get("toolCallId").and_then(Value::as_str) else { return; };
+    let Ok(executable) = std::env::current_exe() else { return; };
+    let helper = executable.with_file_name("zcode-edit-snapshot.cjs");
+    if !helper.is_file() { return; }
+    let mut command = tokio::process::Command::new(node);
+    command.arg(helper).arg(&event.session_id).arg(call).arg(cwd)
+        .stdin(std::process::Stdio::null()).stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null()).kill_on_drop(true);
+    #[cfg(windows)]
+    command.creation_flags(0x08000000);
+    let Ok(Ok(output)) = tokio::time::timeout(std::time::Duration::from_secs(2), command.output()).await else { return; };
+    if !output.status.success() || output.stdout.len() > 2_097_152 { return; }
+    let Ok(metadata) = serde_json::from_slice::<Value>(&output.stdout) else { return; };
+    if metadata["display"] != payload["result"]["display"] { return; }
+    let candidate = serde_json::json!({"metadata": metadata});
+    if tool_diff_content(None, Some(&candidate)).is_some() {
+        payload["result"]["metadata"] = candidate["metadata"].clone();
+    }
+}
