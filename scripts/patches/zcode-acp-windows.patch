+fn collect_prompt_images(blocks: &[ContentBlock]) -> Result<Vec<zp::ImageAttachment>> {
+    use base64::Engine;
+    let mut images = Vec::new();
+    let mut bytes = 0;
+    for block in blocks {
+        if let ContentBlock::Image(image) = block {
+            if !matches!(image.mime_type.as_str(), "image/png" | "image/jpeg" | "image/webp" | "image/gif") {
+                return Err(Error::invalid_params().data("Supported image formats: PNG, JPEG, WebP, GIF"));
+            }
+            if image.data.len() > 14 * 1024 * 1024 {
+                return Err(Error::invalid_params().data("Image exceeds 10 MiB"));
+            }
+            let decoded = base64::engine::general_purpose::STANDARD.decode(&image.data)
+                .map_err(|_| Error::invalid_params().data("Invalid image base64"))?;
+            if decoded.is_empty() || decoded.len() > 10 * 1024 * 1024 {
+                return Err(Error::invalid_params().data("Image must contain 1 byte to 10 MiB"));
+            }
+            bytes += decoded.len();
+            if bytes > 20 * 1024 * 1024 || images.len() >= 8 {
+                return Err(Error::invalid_params().data("At most 8 images and 20 MiB per message"));
+            }
+            let extension = match image.mime_type.as_str() { "image/jpeg" => "jpg", "image/webp" => "webp", "image/gif" => "gif", _ => "png" };
+            images.push(zp::ImageAttachment::Image { data_base64: image.data.clone(), mime_type: image.mime_type.clone(), filename: format!("attachment-{}.{}", images.len() + 1, extension), size_bytes: decoded.len() });
