+#[cfg(test)]
+mod tests {
+    use super::restore;
+    use serde_json::json;
+
+    #[test]
+    fn preserves_mixed_endings_and_untouched_duplicate_text() {
+        let h = json!({"oldStart":2,"oldLines":1,"newStart":2,"newLines":1,"lines":["-old\r","+same\r"]});
+        assert_eq!(restore("same\nsame\r\ntail", &[h]), Some("same\nold\r\ntail".into()));
+    }
+
+    #[test]
+    fn handles_empty_file_and_missing_newline() {
+        let deleted = json!({"oldStart":1,"oldLines":1,"newStart":0,"newLines":0,"lines":["-old","\\ No newline at end of file"]});
+        assert_eq!(restore("", &[deleted]), Some("old".into()));
+        let added = json!({"oldStart":0,"oldLines":0,"newStart":1,"newLines":1,"lines":["+new","\\ No newline at end of file"]});
+        assert_eq!(restore("new", &[added]), Some("".into()));
+    }
+
+    #[test]
+    fn validates_multiple_hunks_and_offsets() {
+        let first = json!({"oldStart":1,"oldLines":1,"newStart":1,"newLines":2,"lines":["-old","+a","+b"]});
+        let second = json!({"oldStart":3,"oldLines":1,"newStart":4,"newLines":1,"lines":["-end","+last"]});
+        assert_eq!(restore("a\nb\nmiddle\nlast\n", &[first.clone(),second.clone()]), Some("old\nmiddle\nend\n".into()));
+        assert_eq!(restore("a\nb\nmiddle\nlast\n", &[second,first]), None);
+    }
+
+    #[test]
+    fn rejects_malformed_or_stale_hunks() {
+        let good = json!({"oldStart":1,"oldLines":1,"newStart":1,"newLines":1,"lines":["-old","+new"]});
+        assert_eq!(restore("different\n", &[good.clone()]), None);
+        assert_eq!(restore("new\n", &[good.clone(),good.clone()]), None);
+        for (key, value) in [("oldLines", json!(2)), ("oldStart", json!(2)), ("lines", json!([42])), ("lines", json!(["?bad"]))] {
+            let mut bad = good.clone();
+            bad[key] = value;
+            assert_eq!(restore("new\n", &[bad]), None);
+        }
+    }
+}
