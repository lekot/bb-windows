+    async fn exercise_usage_reader(stale: bool, timeout: bool) {
+        let (write_tx, mut writes) = mpsc::unbounded_channel();
+        let (events_tx, _events) = mpsc::unbounded_channel();
+        let state = Arc::new(Mutex::new(DriverState {
+            usage_epoch: 0,
