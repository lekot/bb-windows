+fn tool_diff_content(_input: Option<&Value>, result: Option<&Value>) -> Option<ToolCallContent> {
+    let metadata = result?.get("metadata")?;
+    let display = metadata.get("display")?;
+    if display.get("kind")? != "file_diff" {
+        return None;
+    }
+    if display.get("truncated") == Some(&Value::Bool(true)) {
+        return None;
+    }
+    if let Some(serialization) = metadata.get("serialization") {
+        if serialization.get("truncated") == Some(&Value::Bool(true)) {
+            return None;
+        }
+    }
+    let path = display.get("filePath")?.as_str()?;
+    if path.is_empty() {
+        return None;
+    }
+    let read_state = metadata.get("readFileState")?;
+    if read_state.get("isPartialView") != Some(&Value::Bool(false)) {
+        return None;
+    }
+    let read_path = read_state.get("path")?.as_str()?;
+    if read_path != path {
+        return None;
+    }
+    let new_text = read_state.get("content")?.as_str()?;
+    let hunks = display.get("structuredPatch")?.as_array()?;
+    let old_text = crate::inverse_patch::restore(new_text, hunks)?;
+    let diff = acp::schema::Diff::new(path, new_text).old_text(old_text);
+    Some(ToolCallContent::Diff(diff))
+}
