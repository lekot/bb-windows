+        assert!(tool_diff_content(None, Some(&data)).is_none());
+        let mut data = result();
+        data["metadata"]["serialization"] = serde_json::json!({"truncated":true});
+        assert!(tool_diff_content(None, Some(&data)).is_none());
+        let mut data = result();
