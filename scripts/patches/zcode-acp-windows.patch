+#[cfg(test)]
+mod model_capability_tests {
+    use super::*;
+
+    #[test]
+    fn unknown_window_is_not_replaced_with_a_fabricated_million() {
+        for configured in [json!({}), json!({"contextWindow":0}), json!({"contextWindow":-1}), json!({"contextWindow":"1000000"})] {
+            assert!(configured_model_capabilities("glm-5.3", &configured).get("contextWindow").is_none());
+        }
+        assert_eq!(configured_model_capabilities("glm-5.3", &json!({"contextWindow":128000}))["contextWindow"], 128000);
+    }
+}
