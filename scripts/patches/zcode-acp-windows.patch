+#[cfg(test)]
+mod rate_limit_tests {
+    use super::*;
+
+    fn failed_event(code: Option<i64>, message: &str) -> protocol::EventEnvelope {
+        let error = match code {
+            Some(c) => json!({"code": c, "message": message}),
+            None => json!({"message": message}),
+        };
+        protocol::EventEnvelope {
+            event_id: "failed".into(),
+            session_id: "test-session".into(),
+            seq: 1,
+            turn_id: None,
+            timestamp: 0,
+            type_: "turn.failed".into(),
+            payload: Some(json!({"error": error})),
+        }
+    }
+
+    async fn failing_turn_outcome(ev: protocol::EventEnvelope) -> TurnError {
+        let (write_tx, _writes) = mpsc::unbounded_channel();
+        let (events_tx, mut events) = mpsc::unbounded_channel();
+        let (completion, _result) = oneshot::channel();
+        let state = Arc::new(Mutex::new(DriverState {
+            passport: ProcessPassport { path: None, data: json!({}) },
+            runtime_model: Value::Null, write_tx, id_src: Arc::new(IdSource::default()),
+            zcode_session_id: "test-session".into(), pending: HashMap::new(),
+            active_turn: Some(ActiveTurn { generation: Arc::new(()), cancel_requested: false, completion: Some(completion), accumulated_text: String::new(), announced_tools: HashMap::new() }),
+            events_tx, subscribed: true, usage_epoch: 0,
+        }));
+        state.lock().await.handle_event(ev);
+        match tokio::time::timeout(std::time::Duration::from_secs(2), events.recv())
+            .await
+            .expect("turn ended event")
+            .expect("channel open")
+        {
+            SessionMessage::TurnEnded { outcome: Err(e), .. } => e,
+            _ => panic!("expected failed turn"),
+        }
+    }
+
+    #[tokio::test]
+    async fn provider_error_1308_is_classified_as_rate_limited() {
+        let outcome = failing_turn_outcome(failed_event(
+            Some(protocol::GLM_RATE_LIMIT_ERROR_CODE),
+            "Insufficient balance (1308)",
+        ))
+        .await;
+        assert!(
+            matches!(outcome, TurnError::RateLimited(ref m) if m.contains("1308")),
+            "outcome: {outcome:?}"
+        );
+    }
+
+    #[tokio::test]
+    async fn other_provider_errors_stay_generic_failures() {
+        let code = failing_turn_outcome(failed_event(Some(1309), "server sad")).await;
+        assert!(matches!(code, TurnError::Failed(ref m) if m == "server sad"));
+        let no_code = failing_turn_outcome(failed_event(None, "plain failure")).await;
+        assert!(matches!(no_code, TurnError::Failed(ref m) if m == "plain failure"));
+    }
+}
