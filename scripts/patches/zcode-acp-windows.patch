+struct ProcessPassport { path: Option<PathBuf>, data: Value }
+
+impl ProcessPassport {
+    fn mcp_startup(&mut self, value: &Value) {
+        if value["sessionId"] == self.data["sessionId"] && value["kind"] == "session_startup" {
+            self.update("mcp", sanitize_mcp(value));
+        }
+    }
+    fn new(session: &str, cwd: &Path, pid: Option<u32>, created: Option<String>, runtime: &Value, result: &Value) -> Self {
+        let path = std::env::var_os("ZCODE_ACP_CONFIG_PATH").map(PathBuf::from)
+            .and_then(|p| p.parent().map(|p| p.join("bb-status")))
+            .filter(|_| session.chars().all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-'))
+            .map(|p| p.join(format!("{session}.jsonl")));
+        let mut passport = Self { path, data: json!({
+            "version":1,"threadId":std::env::var("BB_THREAD_ID").ok(),"sessionId":session,
+            "adapterPid":std::process::id(),"nativePid":pid,"nativeCreatedFileTime":created,
+            "startedAtUnixMs":unix_ms(),"cwd":cwd,
+            "model":format!("{}/{}",runtime["model"]["providerId"].as_str().unwrap_or("unknown"),runtime["model"]["modelId"].as_str().unwrap_or("unknown")),
+            "reasoning":result["settings"]["thoughtLevel"]["current"],
+            "mcp":{"check":"not_checked"},"state":"idle"
+        }) };
+        passport.update("state", json!("idle"));
+        passport
+    }
+
+    fn update(&mut self, key: &str, value: Value) {
+        self.data[key] = value;
+        self.data["updatedAtUnixMs"] = json!(unix_ms());
+        let Some(path) = &self.path else { return; };
+        let write = || -> std::io::Result<()> {
+            use std::io::Write;
+            if let Some(parent) = path.parent() { std::fs::create_dir_all(parent)?; }
+            let mut file = std::fs::OpenOptions::new().create(true).append(true).open(path)?;
+            let mut record = serde_json::to_vec(&self.data)?;
+            record.push(b'\n');
+            file.write_all(&record)
+        };
+        if write().is_err() { tracing::warn!("Cannot save ZCode process passport"); }
+    }
+}
+
+fn sanitize_mcp(value: &Value) -> Value {
+    let mut report = json!({"check":"startup_snapshot","source":"process/mcpTelemetry","checkedAtUnixMs":unix_ms()});
+    for field in ["configuredCount","connectedCount","failedCount","processCount","occurredAt"] {
+        let Some(count) = value[field].as_u64() else {
+            return json!({"check":"invalid_response","checkedAtUnixMs":unix_ms()});
+        };
+        report[field] = json!(count);
+    }
+    report
+}
+
+fn enrich_model_settings(settings: &mut Value, runtime: &Value) {
+    if let Some(models) = runtime["provider"]["models"].as_array() {
+        settings["model"]["available"] = json!(models.iter().map(|m| json!({"ref":{"providerId":runtime["provider"]["providerId"],"modelId":m["modelId"]}})).collect::<Vec<_>>());
+    }
+}
+
+async fn session_request(state: &Arc<Mutex<DriverState>>, method: &str, mut params: Value) -> Result<Value, String> {
+    let rx = {
+        let mut s = state.lock().await;
+        params["sessionId"] = json!(s.zcode_session_id);
+        s.request(method, params)?
+    };
+    tokio::time::timeout(std::time::Duration::from_secs(15), rx).await
+        .map_err(|_| "Native session request timed out".to_string())?
+        .map_err(|e| e.to_string())?.map_err(|e| e.to_string())
+}
+
+fn instruction_prefix(text: &str) -> Option<&str> {
+    if !text.starts_with("<system_instructions>\n") { return None; }
+    let end = text.find("\n</system_instructions>\n")? + "\n</system_instructions>\n".len();
+    Some(&text[..end])
+}
+
+fn without_duplicate_instructions<'a>(text: &'a str, history: &Value) -> &'a str {
+    let Some(prefix) = instruction_prefix(text) else { return text; };
+    let Some(messages) = history.get("messages").and_then(Value::as_array) else { return text; };
+    let previous = messages.iter().rev()
+        .filter(|m| m["info"]["role"] == "user")
+        .filter_map(|m| m.get("parts").and_then(Value::as_array))
+        .flat_map(|parts| parts.iter().rev())
+        .filter(|part| part["type"] == "text")
+        .filter_map(|part| part.get("text").and_then(Value::as_str))
+        .find_map(instruction_prefix);
+    if previous == Some(prefix) { &text[prefix.len()..] } else { text }
+}
