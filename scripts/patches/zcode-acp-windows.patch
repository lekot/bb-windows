+#[cfg(test)]
+mod diff_tests {
+    use super::*;
+
+    fn result() -> Value {
+        serde_json::json!({"metadata":{
+            "display":{"kind":"file_diff","filePath":"C:\\test\\file.ts","truncated":false,
+                "structuredPatch":[{"oldStart":2,"oldLines":1,"newStart":2,"newLines":1,"lines":["-old","+new"]}]},
+            "readFileState":{"path":"C:\\test\\file.ts","content":"new\nnew\ntail","isPartialView":false}
+        }})
+    }
+
+    #[test]
+    fn emits_complete_exact_file_even_without_tool_input() {
+        let content = tool_diff_content(None, Some(&result())).unwrap();
+        let wire = serde_json::to_value(content).unwrap();
+        assert_eq!(wire["oldText"], "new\nold\ntail");
+        assert_eq!(wire["newText"], "new\nnew\ntail");
+    }
+
+    #[test]
+    fn completed_part_enriches_result_in_either_order_and_rejects_other_session() {
+        for part_first in [true, false] {
+            let mut cache = std::collections::HashMap::new();
+            let envelope = |kind: &str, payload: Value| EventEnvelope {
+                event_id: "event".into(), session_id: "native-session".into(), seq: 1,
+                turn_id: None, timestamp: 0, type_: kind.into(), payload: Some(payload),
+            };
+            let mut part = envelope("part.upserted", serde_json::json!({"part":{
+                "sessionId":"native-session", "callId":"edit-1", "type":"tool", "tool":"Edit",
+                "state":{"status":"completed", "output":"updated", "metadata":result()["metadata"]}
+            }}));
+            let mut foreign = part.clone();
+            foreign.payload.as_mut().unwrap()["part"]["sessionId"] = serde_json::json!("other-session");
+            enrich_completed_edit(&mut foreign, &mut cache);
+            assert_eq!(foreign.type_, "part.upserted");
+            assert!(cache.is_empty());
+            let mut completed = envelope("tool.updated", serde_json::json!({
+                "kind":"result", "toolCallId":"edit-1", "result":{"success":true,"content":"updated","display":result()["metadata"]["display"]}
+            }));
+            if !part_first { enrich_completed_edit(&mut completed, &mut cache); }
+            enrich_completed_edit(&mut part, &mut cache);
+            assert_eq!(part.type_, "tool.updated");
+            if part_first { enrich_completed_edit(&mut completed, &mut cache); }
+            let last = if part_first { completed } else { part };
+            let payload: ToolUpdatedPayload = serde_json::from_value(last.payload.unwrap()).unwrap();
+            let ToolEventTranslation::New(update) = tool_updated_to_calls(&payload, &mut std::collections::HashMap::new()) else { panic!("Expected diff card"); };
+            let wire = serde_json::to_value(update).unwrap();
+            assert_eq!(wire["toolCallId"], "edit-1");
+            assert_eq!(wire["content"][0]["oldText"], "new\nold\ntail");
+            assert_eq!(wire["content"][0]["newText"], "new\nnew\ntail");
+        }
+    }
