+            active_turn: None,
+            events_tx, subscribed: true,
+        }));
+        let reader = UsageReader { state: state.clone() };
+        let read_task = tokio::spawn(async move { reader.read().await });
+        let request = tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            writes.recv(),
+        )
+        .await
