+pub fn restore(new_text: &str, hunks: &[Value]) -> Option<String> {
+    if hunks.is_empty() {
+        return None;
+    }
+    let actual: Vec<&str> = new_text.split_inclusive('\n').collect();
+    let mut output: Vec<String> = Vec::new();
+    let mut cursor = 0usize;
+    for hunk in hunks {
+        let count = |key| usize::try_from(hunk.get(key)?.as_u64()?).ok();
+        let old_count = count("oldLines")?;
+        let new_count = count("newLines")?;
+        let offset = |start: usize, len: usize| {
+            if len == 0 { Some(start) } else { start.checked_sub(1) }
+        };
+        let old_start = offset(count("oldStart")?, old_count)?;
+        let new_start = offset(count("newStart")?, new_count)?;
+        if new_start < cursor || new_start > actual.len() {
+            return None;
+        }
+        output.extend(actual[cursor..new_start].iter().map(|s| s.to_string()));
+        if old_start != output.len() {
+            return None;
+        }
+        let mut old_side: Vec<String> = Vec::new();
+        let mut new_side: Vec<String> = Vec::new();
+        let mut previous = None;
+        for line in hunk.get("lines")?.as_array()? {
+            let line = line.as_str()?;
+            if line == "\\ No newline at end of file" {
+                match previous.take()? {
+                    b'-' => { old_side.last_mut()?.pop()?; }
+                    b'+' => { new_side.last_mut()?.pop()?; }
+                    b' ' => { old_side.last_mut()?.pop()?; new_side.last_mut()?.pop()?; }
+                    _ => return None,
+                }
+                continue;
+            }
+            let prefix = *line.as_bytes().first()?;
+            let body = line.get(1..)?;
+            if body.contains('\n') {
+                return None;
+            }
+            let text = format!("{body}\n");
+            match prefix {
+                b'-' => old_side.push(text),
+                b'+' => new_side.push(text),
+                b' ' => { old_side.push(text.clone()); new_side.push(text); }
+                _ => return None,
+            }
+            previous = Some(prefix);
+        }
+        if old_side.len() != old_count || new_side.len() != new_count {
+            return None;
+        }
+        let end = new_start.checked_add(new_count)?;
+        if end > actual.len() || !new_side.iter().map(String::as_str).eq(actual[new_start..end].iter().copied()) {
+            return None;
+        }
+        output.extend(old_side);
+        cursor = end;
+    }
+    output.extend(actual[cursor..].iter().map(|s| s.to_string()));
+    if output.iter().take(output.len().saturating_sub(1)).any(|s| !s.ends_with('\n')) {
+        return None;
+    }
+    Some(output.concat())
+}
